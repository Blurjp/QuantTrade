# QuantTrade Environment Variables
# Copy this file to .env and fill in your values
#
# NOTE: Real satellite data is now FULLY AUTOMATED!
# Just install the required packages and it will auto-detect and use real data.
# See: pipeline/satellite_data.py -> get_capabilities()

# =============================================================================
# Satellite Data Configuration (AUTOMATIC)
# =============================================================================
#
# Real satellite data is automatically enabled when packages are installed.
# No environment variables needed! The system auto-detects:
#   - Planetary Computer packages (pystac-client, odc-stac, planetary-computer)
#   - NASA Earthdata credentials (for precipitation data)
#
# To enable real data, just run:
#   pip install pystac-client odc-stac planetary-computer
#
# For precipitation data, also set NASA credentials below.

# Optional: Force disable real data (use simulated)
# USE_REAL_SATELLITE_DATA=false

# Optional: Force enable real data (skip auto-detection)
# USE_REAL_SATELLITE_DATA=true

# Optional: Custom cache directory (default: outputs/satellite_cache)
# SATELLITE_CACHE_DIR=outputs/satellite_cache

# =============================================================================
# NASA Earthdata Credentials (for precipitation data only)
# =============================================================================
#
# Required only for GPM/IMERG precipitation data from NASA GES DISC.
# Planetary Computer data (Sentinel, Landsat, MODIS, VIIRS) is FREE and
# requires NO authentication.
#
# Register for free at: https://urs.earthdata.nasa.gov/

NASA_EARTHDATA_USERNAME=your_username
NASA_EARTHDATA_PASSWORD=your_password

# =============================================================================
# EIA API (for energy data)
# =============================================================================

# Get key at: https://www.eia.gov/opendata/register.php
EIA_API_KEY=your_eia_api_key

# =============================================================================
# Email Notification Settings (for trading signal alerts)
# =============================================================================
#
# Configure email notifications when actionable signals are detected.
#
# SMTP server settings (examples):
#   Gmail: smtp.gmail.com:587
#   Outlook: smtp.office365.com:587
#   QQ Mail: smtp.qq.com:587
#   163 Mail: smtp.163.com:25
#
# For Gmail, you need to:
#   1. Enable 2-Factor Authentication
#   2. Generate an App Password: https://myaccount.google.com/apppasswords
#   3. Use the App Password as SMTP_PASSWORD

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Notification recipients (comma-separated)
NOTIFICATION_TO=your_email@example.com
NOTIFICATION_FROM=your_email@gmail.com

# Optional: SMS notification via email gateway
# Example: 1234567890@vtext.com (Verizon)
#          1234567890@txt.att.net (AT&T)
#          1234567890@messaging.sprintpcs.com (Sprint)
SMS_GATEWAY=

# =============================================================================
# LLM API Keys (for chat features)
# =============================================================================

OPENAI_API_KEY=your_openai_key
ANTHROPIC_API_KEY=your_anthropic_key

# =============================================================================
# Application Settings
# =============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Output directory
OUTPUT_DIR=outputs
